# === RKW WhatsApp Bot - Phase 1 Configuration ===

# ID group WhatsApp yang mau dipantau.
# Format: "<angka panjang>@g.us"
# Cara mengetahuinya: lihat README.md bagian "Cara mengetahui GROUP_ID".
GROUP_ID=

# Daftar nomor pengirim yang diizinkan (dipisahkan koma, TANPA spasi setelah koma).
# Format nomor: kode negara + nomor, TANPA "+", TANPA "@c.us".
# Contoh: 628123456789,628987654321
ALLOWED_SENDERS=

# (Opsional) Folder penyimpanan hasil download. Default: ./storage
STORAGE_DIR=./storage
